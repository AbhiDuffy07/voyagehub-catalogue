{
  "$defs": {
    "Credit": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "title": "Attribution",
          "type": "string"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Author"
        },
        "history_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Url"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "licence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence Url"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "author",
        "licence",
        "licence_url",
        "source_url",
        "attribution"
      ],
      "title": "Credit",
      "type": "object"
    },
    "IndexCity": {
      "additionalProperties": false,
      "properties": {
        "country_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country Iso"
        },
        "country_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country Name"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "hero": {
          "anyOf": [
            {
              "$ref": "#/$defs/Photo"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Slug",
          "type": "string"
        },
        "tier": {
          "enum": [
            "plannable",
            "browse_only",
            "not_ready"
          ],
          "title": "Tier",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title",
        "country_iso",
        "country_name",
        "tier",
        "hero",
        "file"
      ],
      "title": "IndexCity",
      "type": "object"
    },
    "IndexShard": {
      "additionalProperties": false,
      "properties": {
        "cities": {
          "title": "Cities",
          "type": "integer"
        },
        "country_iso": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country Iso"
        },
        "country_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country Name"
        },
        "file": {
          "title": "File",
          "type": "string"
        }
      },
      "required": [
        "country_iso",
        "country_name",
        "file",
        "cities"
      ],
      "title": "IndexShard",
      "type": "object"
    },
    "Photo": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption"
        },
        "credit": {
          "$ref": "#/$defs/Credit"
        },
        "height": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Height"
        },
        "thumb_url": {
          "title": "Thumb Url",
          "type": "string"
        },
        "thumb_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thumb Width"
        },
        "width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Width"
        }
      },
      "required": [
        "thumb_url",
        "thumb_width",
        "width",
        "height",
        "credit"
      ],
      "title": "Photo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Exactly one of `cities` (a flat index, also each shard file) or `shards` (the top file\nof a world-sized index, one entry per country file).",
  "properties": {
    "cities": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/IndexCity"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cities"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "shards": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/IndexShard"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shards"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "IndexFile",
  "type": "object"
}

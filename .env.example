# Variable names only. Copy to .env (gitignored) and fill in locally. Never commit real values.

# A project address for the Wikimedia User-Agent (not your personal email if you can avoid it).
CONTACT_EMAIL=
# Optional: the project website or repo URL shown in the User-Agent.
APP_WEBSITE=
# Postgres as the catalogue_importer role (session pooler, TLS). Needed only for jobs that write.
CATALOGUE_DATABASE_URL=

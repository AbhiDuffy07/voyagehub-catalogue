# Secrets: never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Pipeline output and big downloads (no heavy generated files in git)
out/
catalogue/out/
dumps/
*.xml.bz2
*.osm.pbf
*.log

# Left behind only if a registry save crashes half way
data/*.tmp

# Local tool files
.claude/settings.local.json
.vscode/
.idea/
